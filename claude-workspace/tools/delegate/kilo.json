{
  "$schema": "https://kilo.ai/config.json",
  "model": "kilo/kilo-auto/free",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "external_directory": "deny",
    "webfetch": "deny",
    "edit": {
      "*": "allow",
      "*.FCStd": "deny",
      "**/*.FCStd": "deny",
      "**/print.yaml": "deny",
      "**/community/**": "deny",
      "**/.env": "deny",
      "**/parent-reports/**": "deny",
      "**/org/*.yaml": "deny"
    },
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "rm -rf*": "deny",
      "Remove-Item*": "deny"
    }
  }
}
