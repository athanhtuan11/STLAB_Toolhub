# Repo cong dong: chi luu diem ghim (community/pins.tsv), khong luu ban clone.
# Dung lai bang: community/update-community.sh clone
/community/*/
!/community/reports/

# Symlink toi skill/agent cong dong: tao lai bang community/update-community.sh link
**/.claude/skills/
**/.claude/agents/

# Du lieu ca nhan hoc vien: khong dua len GitHub
/stlab/parent-reports/

# Moi truong Python (uv tao lai tu uv.lock)
.venv/
__pycache__/
# Thu vien cai rieng cho freecadcmd (pip --target), cai lai theo docs/COMMUNITY.md (manifold3d)
/tools/robotics-cad/.pylib/
# Du an CAD (maker/<project>/): file FreeCAD chi de tren may (Tuan chon 2026-10-23), ban sao luu + file sinh
/maker/*/freecad/*.FCStd
/maker/*/freecad/*.FCBak
/maker/*/freecad/backup/
/maker/*/freecad/check/
/maker/*/print/stl/
/maker/*/print/plates/
/maker/*/print/plates-*/
/maker/*/print/_*

# Bi mat va cau hinh ca nhan
.env
.env.*
*.local.json
CLAUDE.local.md
credentials*.json


# video-ai: clip/phan tich/ket qua la du lieu rieng tu va nang -> khong len git
/video-ai/projects/*/

# photo-ai: model tai lai theo models/SHA256SUMS; anh la du lieu rieng tu
/photo-ai/models/*.onnx
/photo-ai/models/*.task
# photo-ai: LUT tao lai bang scripts/luts.py --default (tu nguon cong dong)
/photo-ai/luts/
/photo-ai/.lab-state.json
/photo-ai/tools/*
!/photo-ai/tools/SHA256SUMS

# Lop phu RobotCAD (junction toi community/, sinh bang custom/freecad/robotcad_overlay.py)
/custom/freecad/robotcad-overlay/
/maker/*/freecad/images/assembly/raw/
/maker/*/print/stl-*/

# Thu muc tam cua executor (tools/delegate/delegate.py), xoa sau moi run
.delegate-tmp/
