# Repo cong dong: chi luu diem ghim (community/pins.tsv), khong luu ban clone.
# Dung lai bang: community/update-community.sh clone
/community/*/
!/community/reports/

# Symlink toi skill/agent cong dong: tao lai bang community/update-community.sh link
**/.claude/skills/
**/.claude/agents/

# Du lieu ca nhan hoc vien: khong dua len GitHub
/stlab/parent-reports/

# Moi truong Python (uv tao lai tu uv.lock)
.venv/
__pycache__/
# Thu vien cai rieng (pip --target) cho printability/fast_collide, cai lai theo docs/COMMUNITY.md (manifold3d)
/tools/print/.pylib/
# Du an CAD (maker/<project>/): file FreeCAD chi de tren may (Tuan chon 2026-10-23), ban sao luu + file sinh
/maker/*/freecad/*.FCStd
/maker/*/freecad/*.FCBak
/maker/*/freecad/backup/
/maker/*/freecad/check/
/maker/*/print/stl/
/maker/*/print/plates/
/maker/*/print/plates-*/
/maker/*/print/_*
# Anh/video/am thanh sinh ra trong du an maker: chi de tren may, khong len git (Tuan 2026-10-30: ton dung luong cloud)
/maker/**/*.png
/maker/**/*.jpg
/maker/**/*.jpeg
/maker/**/*.gif
/maker/**/*.webp
/maker/**/*.mp4
/maker/**/*.mov
/maker/**/*.webm
/maker/**/*.mp3
/maker/**/*.wav
/maker/*/freecad/images/
/maker/**/*.pdf
/maker/*/freecad/**/*.FCStd

# Bi mat va cau hinh ca nhan
.env
.env.*
*.local.json
CLAUDE.local.md
credentials*.json


# video-ai: clip/phan tich/ket qua la du lieu rieng tu va nang -> khong len git
/video-ai/projects/*/

# photo-ai: model tai lai theo models/SHA256SUMS; anh la du lieu rieng tu
/photo-ai/models/*.onnx
/photo-ai/models/*.task
# photo-ai: LUT tao lai bang scripts/luts.py --default (tu nguon cong dong)
/photo-ai/luts/
/photo-ai/.lab-state.json
/photo-ai/tools/*
!/photo-ai/tools/SHA256SUMS

/maker/*/freecad/images/assembly/raw/
/maker/*/print/stl-*/

# Thu muc tam cua executor (tools/delegate/delegate.py), xoa sau moi run
.delegate-tmp/

# File trung gian cua tools/render (render.py --out <dir>): luoi STL + scene/export json
**/_stl/
*-scene.json
*-export.json

# File sinh/tam trong maker/ (Tuan 2026-11-09: chi dua file quan trong len git; sinh lai tu script + *-params.json)
/maker/**/backup/
/maker/**/*.bak
/maker/**/*.log
/maker/**/result.json
/result.json
/maker/**/out/*.stl
/maker/**/out/*.3mf
/maker/**/out/*.sc
/maker/**/out/asm/
/maker/*/marketing/stills/raw/
/maker/*/marketing/stills/assets/

# Ban cu/loi/da thay (Tuan 2026-11-05: khong xoa, chuyen vao backup/<ngay>-<ly do>/) - chi de tren may, lich su git van giu
/backup/

# File sinh/nang ngoai maker/ (2026-11-11): log, model luoi/CAD. KHONG ignore *.bin (firmware releases can cho OTA)
*.log
*.FCStd
*.FCBak
*.stl
*.3mf
*.step
*.stp
!/community/pin-history.log
/maker/cyberbrick-arm/gripper-v2/out/
/maker/cyberbrick-arm/gripper-v2/plates/

# SolidCraft tu sinh khi ghi de .sc
*.sc.bak

# Nhac Cu Bong (Tuan tu chep, khong len git)
/maker/english-teacher/server/music/*
!/maker/english-teacher/server/music/README.md
