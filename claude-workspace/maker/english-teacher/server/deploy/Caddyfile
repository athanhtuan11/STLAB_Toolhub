# Caddy tren VPS: HTTPS tu dong (Let's Encrypt) cho domain cua co giao, chuyen tiep ve may lab qua frp.
# PUBLIC_HOST dat trong /etc/default/caddy (vd PUBLIC_HOST=teacher.example.vn). Cong 18003/18000 chi nghe 127.0.0.1 (frps).
{$PUBLIC_HOST} {
	handle /xiaozhi/ota/* {
		reverse_proxy 127.0.0.1:18003
	}
	handle /xiaozhi/v1/* {
		reverse_proxy 127.0.0.1:18000
	}
	handle {
		respond 404
	}
	log {
		output file /var/log/caddy/teacher.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
