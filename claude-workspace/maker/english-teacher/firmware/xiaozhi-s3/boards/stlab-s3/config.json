{
    "type": "stlab-s3",
    "target": "esp32s3",
    "builds": [
        {
            "name": "stlab-s3",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_STLAB_S3=y",
                "CONFIG_USE_AUDIO_PROCESSOR=y",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_WAKE_WORD_DISABLED=y"
            ]
        }
    ]
}
