# ESP32-WROOM-32D, flash 4 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Ket noi Wi-Fi lan dau qua Bluetooth (app RainMaker)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# RainMaker (theo esp_rainmaker test_app)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168
CONFIG_ESP_RMAKER_WORK_QUEUE_TASK_STACK=4096
# Dieu khien noi bo khi dien thoai cung mang Wi-Fi (nhanh, khong qua cloud)
CONFIG_ESP_RMAKER_LOCAL_CTRL_AUTO_ENABLE=y

# Gio Viet Nam (UTC+7) - mac dinh thu vien la Asia/Shanghai (UTC+8, lech 1 gio -> lich 6h chay 5h)
CONFIG_ESP_RMAKER_DEF_TIMEZONE="Asia/Ho_Chi_Minh"

# OTA tu xa an toan: ban moi khong ket noi duoc cloud trong ESP_RMAKER_OTA_ROLLBACK_WAIT_PERIOD (90 s) -> tu quay ve ban cu.
# Nam trong BOOTLOADER -> KHONG doi duoc qua OTA, phai nap USB 1 lan (2026-10-25).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Tac vu FreeRTOS "Tmr Svc" chay timer cua RainMaker OTA (ota_timeout, rollback). Mac dinh 2048 -> TRAN STACK lan
# khoi dong dau sau OTA (do thuc te 2026-10-25, ban 1.1.1) -> 4096
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
