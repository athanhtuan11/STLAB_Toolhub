# ESP32-WROOM-32D, flash 4 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Ket noi Wi-Fi lan dau qua Bluetooth (app RainMaker)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# RainMaker (theo esp_rainmaker test_app)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168
CONFIG_ESP_RMAKER_WORK_QUEUE_TASK_STACK=4096
# Dieu khien noi bo khi dien thoai cung mang Wi-Fi (nhanh, khong qua cloud)
CONFIG_ESP_RMAKER_LOCAL_CTRL_AUTO_ENABLE=y
