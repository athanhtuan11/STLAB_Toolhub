{
  "permissions": {
    "allow": [
      "Bash(tasklist)",
      "Bash(tasklist *)",
      "Bash(agy -p *)",
      "Bash(opencode run *)",
      "Bash(python tools/delegate/delegate.py *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:/04_Stlab/04_STLAB_Toolhub/claude-workspace/custom/hooks/guard_paths.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:/04_Stlab/04_STLAB_Toolhub/claude-workspace/custom/hooks/event_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:/04_Stlab/04_STLAB_Toolhub/claude-workspace/custom/hooks/event_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:/04_Stlab/04_STLAB_Toolhub/claude-workspace/custom/hooks/event_log.py\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:/04_Stlab/04_STLAB_Toolhub/claude-workspace/custom/hooks/event_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:/04_Stlab/04_STLAB_Toolhub/claude-workspace/custom/hooks/event_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:/04_Stlab/04_STLAB_Toolhub/claude-workspace/custom/hooks/event_log.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
